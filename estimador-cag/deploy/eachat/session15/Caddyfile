{$PUBLIC_HOST} {
    encode zstd gzip

    log {
        output stdout
        format json
    }

    request_body {
        max_size 2MB
    }

    reverse_proxy eachat:8000 {
        health_uri /ready
        health_interval 15s
        health_timeout 3s
        transport http {
            dial_timeout 5s
            response_header_timeout 180s
        }
    }
}
