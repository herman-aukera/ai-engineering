# Local/development examples only. Never commit real credentials.
DEEPSEEK_API_KEY=replace-with-deepseek-key
KIMI_API_KEY=replace-with-kimi-key
OPENAI_API_KEY=replace-with-openai-key
DATABASE_URL=postgresql://dev:dev@localhost:5432/lidr
REDIS_URL=redis://localhost:6379/0

# Session 13 Plus integration bridge. Keep legacy for configuration-only rollback.
ESTIMATION_BACKEND=legacy
GRAPH_RETRIEVAL_MODE=sequential
GRAPH_RETRIEVAL_MAX_CONCURRENCY=4
SESSION14_CONFIDENCE_THRESHOLD=0.65

# Same-origin demos require no CORS grant. Add only explicit trusted cross-origin callers.
CORS_ORIGINS=

# Session 15 production deploy additionally requires ESTIMADOR_IMAGE and PUBLIC_HOST.
# Use durable external PostgreSQL/Redis endpoints for replaceable/Spot compute.
