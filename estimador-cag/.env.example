# Local/development examples only. Never commit real credentials.
DEEPSEEK_API_KEY=replace-with-deepseek-key
KIMI_API_KEY=replace-with-kimi-key
OPENAI_API_KEY=replace-with-openai-key

# EACHAT final-project support RAG.
# Keep the final-project RAG disabled until the curated corpus has been ingested.
EACHAT_SUPPORT_RAG_ENABLED=false
# May point to the same PostgreSQL instance as EACHAT_POSTGRES_URL or a dedicated database.
EACHAT_SUPPORT_RAG_DATABASE_URL=postgresql://eachat:replace-me@db.example.internal:5432/eachat
# Dedicated embedding key is preferred; OPENAI_API_KEY is the documented fallback.
EACHAT_SUPPORT_EMBEDDING_API_KEY=replace-with-openai-embedding-key
EACHAT_SUPPORT_EMBEDDING_MODEL=text-embedding-3-small

# EACHAT production runtime contract.
EACHAT_POSTGRES_URL=postgresql://eachat:replace-me@db.example.internal:5432/eachat
EACHAT_MEMORY_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Inject a high-entropy backend session key (>=32 bytes) through the runtime secret manager.
EACHAT_SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
LANGGRAPH_STRICT_MSGPACK=true
EACHAT_V2_ENABLED=true
EACHAT_CORS_ORIGINS=

# Production deployment values are runtime configuration, never baked into images.
EACHAT_IMAGE=ghcr.io/owner/eachat@sha256:replace-with-digest
PUBLIC_HOST=chat.example.com
