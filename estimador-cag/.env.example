# Local/development examples only. Never commit real credentials.
DEEPSEEK_API_KEY=replace-with-deepseek-key
KIMI_API_KEY=replace-with-kimi-key
OPENAI_API_KEY=replace-with-openai-key
DATABASE_URL=postgresql://dev:dev@localhost:5432/lidr

# EACODE production HTTP surface is same-origin by default.
# Add only explicit trusted origins when a separate browser origin is required.
EACODE_CORS_ORIGINS=
