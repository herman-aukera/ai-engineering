# Local/development provider examples only. Never commit real credentials.
DEEPSEEK_API_KEY=replace-with-deepseek-key
KIMI_API_KEY=replace-with-kimi-key
OPENAI_API_KEY=replace-with-openai-key

# EACODE canonical production authority contract.
EACODE_DATABASE_URL=postgresql://eacode:replace-me@db.example.internal:5432/eacode
EACODE_SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
EACODE_CORS_ORIGINS=

# Immutable deployment configuration.
EACODE_IMAGE=ghcr.io/owner/eacode@sha256:replace-with-digest
PUBLIC_HOST=code.example.com

# Local/coursework compatibility only; production Compose does not use this.
EACODE_DEMO_DB_PATH=.eacode/eacode-demo.sqlite3
