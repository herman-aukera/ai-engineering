# Local/development examples only. Never commit real credentials.
DEEPSEEK_API_KEY=replace-with-deepseek-key
KIMI_API_KEY=replace-with-kimi-key
OPENAI_API_KEY=replace-with-openai-key
DATABASE_URL=postgresql://dev:dev@localhost:5432/lidr
REDIS_URL=redis://localhost:6379/0

# Production estimator ownership. Inject a high-entropy backend signing key
# (>=32 bytes) through the runtime secret manager.
ESTIMATOR_SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Explicit local/test escape hatch only. Production Compose never enables it.
ESTIMATOR_ALLOW_IN_MEMORY_OWNERSHIP=false

# Canonical unified estimator policy/runtime.
GRAPH_RETRIEVAL_MODE=sequential
GRAPH_RETRIEVAL_MAX_CONCURRENCY=4
SESSION14_CONFIDENCE_THRESHOLD=0.65
PROVIDER_BENCHMARK_SNAPSHOT_PATH=

# Same-origin clients require no CORS grant. Add only trusted explicit callers.
CORS_ORIGINS=

# Production deployment values are supplied on the host/secret manager, not baked in.
ESTIMADOR_IMAGE=ghcr.io/owner/estimador-cag@sha256:replace-with-digest
PUBLIC_HOST=estimate.example.com
