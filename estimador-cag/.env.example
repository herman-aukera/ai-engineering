# Local/development examples only. Never commit real credentials.
DEEPSEEK_API_KEY=replace-with-deepseek-key
KIMI_API_KEY=replace-with-kimi-key
OPENAI_API_KEY=replace-with-openai-key

# EACHAT production runtime contract.
EACHAT_POSTGRES_URL=postgresql://eachat:replace-me@db.example.internal:5432/eachat
EACHAT_MEMORY_ENCRYPTION_KEY=replace-with-generated-fernet-key
LANGGRAPH_STRICT_MSGPACK=true
EACHAT_V2_ENABLED=true
EACHAT_CORS_ORIGINS=

# Production deployment values are runtime configuration, never baked into images.
EACHAT_IMAGE=ghcr.io/owner/eachat@sha256:replace-with-digest
PUBLIC_HOST=chat.example.com
